<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.CreateEventController">
   <children>
      <Label text="Create New Event" styleClass="title-label">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" spacing="15.0" styleClass="form-container" prefWidth="500.0">
         <children>
            <TextField fx:id="nameField" promptText="Event Name" prefWidth="400.0" />
            <TextField fx:id="dateField" promptText="Date &amp; Time (yyyy-MM-dd HH:mm)" prefWidth="400.0" />
            <TextField fx:id="locationField" promptText="Location" prefWidth="400.0" />
            <TextArea fx:id="descriptionField" promptText="Description" prefWidth="400.0" prefRowCount="4" wrapText="true" />
            <TextField fx:id="priceField" promptText="Ticket Price" prefWidth="400.0" />
            <TextField fx:id="seatsField" promptText="Total Seats" prefWidth="400.0" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="createButton" onAction="#handleCreate" text="Create Event" prefWidth="150.0" />
                  <Button fx:id="cancelButton" onAction="#handleCancel" text="Cancel" prefWidth="150.0" />
               </children>
            </HBox>
            <Label fx:id="errorLabel" styleClass="error-label" text="" textFill="#d32f2f" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>

