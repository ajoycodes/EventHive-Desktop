<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.LoginController">
   <children>
      <Label text="EventHive" styleClass="title-label">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Label>
      <Label text="Event Management System" styleClass="subtitle-label">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" spacing="15.0" styleClass="form-container">
         <children>
            <TextField fx:id="usernameField" promptText="Username or Email" prefWidth="300.0" />
            <PasswordField fx:id="passwordField" promptText="Password" prefWidth="300.0" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="loginButton" onAction="#handleLogin" text="Login" prefWidth="140.0" />
                  <Button fx:id="signupButton" onAction="#handleSignup" text="Sign Up" prefWidth="140.0" />
               </children>
            </HBox>
            <Label fx:id="errorLabel" styleClass="error-label" text="" textFill="#d32f2f" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>

