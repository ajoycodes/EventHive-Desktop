<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.UserDashboardController" stylesheets="@../styles/modern.css">
   <top>
      <VBox>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header">
               <children>
                  <Label text="EventHive - User Dashboard" styleClass="header-title">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="welcomeLabel" text="Welcome, User" />
                  <Button fx:id="logoutButton" onAction="#handleLogout" text="Logout" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </top>
   <left>
      <VBox spacing="10.0" styleClass="sidebar">
         <children>
            <Button fx:id="viewEventsButton" onAction="#handleViewEvents" text="View Events" prefWidth="200.0" />
            <Button fx:id="myTicketsButton" onAction="#handleMyTickets" text="My Tickets" prefWidth="200.0" />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true">
         <VBox spacing="20.0" styleClass="content">
            <children>
               <Label text="Welcome to EventHive!" styleClass="welcome-text">
                  <font>
                     <Font name="System Bold" size="28.0" />
                  </font>
               </Label>
               <Label fx:id="statsLabel" text="Select an option from the sidebar to get started" />
               <Separator />
               <HBox spacing="20.0" alignment="CENTER_LEFT">
                  <children>
                     <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card" prefWidth="200.0" prefHeight="150.0">
                        <children>
                           <Label fx:id="ticketsCountLabel" styleClass="stat-number" text="0" />
                           <Label text="My Tickets" styleClass="stat-label" />
                        </children>
                        <padding>
                           <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                     </VBox>
                     <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card" prefWidth="200.0" prefHeight="150.0">
                        <children>
                           <Label fx:id="totalSpentLabel" styleClass="stat-number" text="0.00" />
                           <Label text="Total Spent" styleClass="stat-label" />
                        </children>
                        <padding>
                           <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                        </padding>
                     </VBox>
                  </children>
               </HBox>
            </children>
            <padding>
               <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>
         </VBox>
      </ScrollPane>
   </center>
</BorderPane>

