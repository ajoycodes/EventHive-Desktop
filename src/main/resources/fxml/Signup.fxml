<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.SignupController">
   <children>
      <Label text="Create Account" styleClass="title-label">
         <font>
            <Font name="System Bold" size="32.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" spacing="15.0" styleClass="form-container">
         <children>
            <TextField fx:id="usernameField" promptText="Username" prefWidth="300.0" />
            <TextField fx:id="emailField" promptText="Email" prefWidth="300.0" />
            <PasswordField fx:id="passwordField" promptText="Password" prefWidth="300.0" />
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" prefWidth="300.0" />
            <Label text="Select Role(s):" />
            <VBox spacing="5.0">
               <children>
                  <CheckBox fx:id="userRoleCheckBox" text="User" selected="true" />
                  <CheckBox fx:id="organizerRoleCheckBox" text="Organizer" />
                  <CheckBox fx:id="adminRoleCheckBox" text="Admin" />
               </children>
            </VBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="signupButton" onAction="#handleSignup" text="Sign Up" prefWidth="140.0" />
                  <Button fx:id="backButton" onAction="#handleBack" text="Back to Login" prefWidth="140.0" />
               </children>
            </HBox>
            <Label fx:id="errorLabel" styleClass="error-label" text="" textFill="#d32f2f" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>

