<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="app.controllers.ForgotPasswordController" styleClass="login-container"
           stylesheets="@../styles/modern.css">
   <VBox styleClass="login-card" spacing="20" alignment="CENTER" maxWidth="400">
      <!-- App Logo/Title -->
      <Label text="EventHive" styleClass="label-title">
         <font>
            <Font name="System Bold" size="32"/>
         </font>
      </Label>
      
      <Label text="Reset Password" styleClass="label-subheader" textAlignment="CENTER">
         <font>
            <Font size="16"/>
         </font>
      </Label>
      
      <Label text="Enter your email address and we'll help you reset your password." 
             styleClass="label-caption" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="13"/>
         </font>
      </Label>
      
      <!-- Forgot Password Form -->
      <VBox spacing="16" VBox.vgrow="ALWAYS">
         <Label text="Email Address" styleClass="label-caption"/>
         <TextField fx:id="emailField" promptText="Enter your email address"/>
         
         <Label fx:id="messageLabel" styleClass="label-caption" text="" wrapText="true"/>
      </VBox>
      
      <!-- Action Buttons -->
      <VBox spacing="12" alignment="CENTER">
         <Button fx:id="submitButton" onAction="#handleSubmit" text="Send Reset Instructions" 
                 styleClass="button-primary" prefWidth="300">
            <font>
               <Font size="15" />
            </font>
         </Button>
         
         <Hyperlink onAction="#handleBackToLogin" text="Back to Login" styleClass="link-text">
            <font>
               <Font size="13"/>
            </font>
         </Hyperlink>
      </VBox>
      
      <padding>
         <Insets top="32" bottom="32" left="40" right="40"/>
      </padding>
   </VBox>
</StackPane>
