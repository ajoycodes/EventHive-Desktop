<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.controllers.BookTicketController" stylesheets="@../styles/modern.css">
   <children>
      <Label text="Book Ticket" styleClass="title-label">
         <font>
            <Font name="System Bold" size="28.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" spacing="15.0" styleClass="form-container">
         <children>
            <Label fx:id="eventNameLabel" text="Event: " styleClass="info-label">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Label fx:id="eventDateLabel" text="Date: " styleClass="info-label" />
            <Label fx:id="eventLocationLabel" text="Location: " styleClass="info-label" />
            <Label fx:id="eventPriceLabel" text="Price: " styleClass="info-label" />
            <Label fx:id="eventSeatsLabel" text="Available Seats: " styleClass="info-label" />
            <Separator prefWidth="400.0" />
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="confirmButton" onAction="#handleConfirmBooking" text="Confirm Booking" prefWidth="150.0" />
                  <Button fx:id="cancelButton" onAction="#handleCancel" text="Cancel" prefWidth="150.0" />
               </children>
            </HBox>
            <Label fx:id="errorLabel" styleClass="error-label" text="" textFill="#d32f2f" />
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>

